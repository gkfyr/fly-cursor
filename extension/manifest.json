{
  "manifest_version": 3,
  "name": "Fly Cursor · Connectome Lab",
  "version": "0.1.2",
  "description": "MaleCNS 실제 신경 연결로 현재 웹사이트 위 초파리 가상 커서를 움직입니다.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fly Cursor"
  },
  "key": ""
}
